EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Deploy Edge Function (reset-password) ───
# 1. Install Supabase CLI: npm i -g supabase
# 2. Login: supabase login
# 3. Link project: supabase link --project-ref viopzsgthvoguerkxxji
# 4. Set the service role key as a secret:
#    supabase secrets set SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
# 5. Deploy the function:
#    supabase functions deploy reset-password
#
# The service_role key is found in:
# Supabase Dashboard → Settings → API → service_role (secret)
